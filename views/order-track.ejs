<%- include('partials/header') %>

<div style="max-width: 850px; margin: 2.5rem auto 4rem; padding: 0 1.5rem; flex: 1;">
    <!-- Top Breadcrumb -->
    <div style="margin-bottom: 1.5rem; display: flex; justify-content: space-between; align-items: center;">
        <a href="/my-orders" style="color: var(--primary); font-weight: 600; font-size: 0.95rem;">← Back to My Orders</a>
        <span style="font-size: 0.9rem; color: var(--text-muted);">Live Order Feed</span>
    </div>

    <!-- Main Tracking Card -->
    <div style="background: #fff; border-radius: var(--radius-lg); border: 1px solid var(--border-color); box-shadow: var(--card-shadow); padding: 2.5rem;">
        <div style="display: flex; justify-content: space-between; align-items: center; border-bottom: 1px solid var(--border-color); padding-bottom: 1.5rem;">
            <div>
                <h2 style="font-size: 1.8rem; margin-bottom: 0.2rem;">Tracking Order #<%= order.orderId %></h2>
                <p style="color: var(--text-muted); font-size: 0.9rem;">
                    Estimated Delivery: <strong style="color: var(--primary);"><%= order.estimatedDelivery || '30-40 mins' %></strong>
                </p>
            </div>

            <div style="text-align: right;">
                <div style="font-size: 0.85rem; color: var(--text-muted);">Payment Mode</div>
                <div style="font-weight: 700; color: var(--secondary);"><%= order.paymentMethod === 'COD' ? '💵 Cash on Delivery' : '📱 Paid Online' %></div>
            </div>
        </div>

        <% if (order.orderStatus === 'Cancelled') { %>
            <div style="background: #FEF2F2; border: 1px solid #FCA5A5; color: #991B1B; padding: 1.5rem; border-radius: var(--radius-md); margin: 2rem 0; text-align: center;">
                <h3 style="margin-bottom: 0.4rem;">🚫 Order Cancelled</h3>
                <p style="font-size: 0.9rem;">This order was cancelled. If you have questions or need assistance, please contact kitchen support.</p>
            </div>
        <% } else { %>
            <!-- 4-STEP TRACKING TIMELINE -->
            <%
                const steps = ['Placed', 'Preparing', 'Out for Delivery', 'Delivered'];
                const currentIdx = steps.indexOf(order.orderStatus);
            %>
            <div class="status-timeline">
                <% steps.forEach(function(stepName, idx) { %>
                    <%
                        let stepClass = '';
                        if (idx < currentIdx) stepClass = 'completed';
                        else if (idx === currentIdx) stepClass = 'active';
                    %>
                    <div class="status-step <%= stepClass %>">
                        <div class="step-icon">
                            <%= idx === 0 ? '📝' : (idx === 1 ? '👨‍🍳' : (idx === 2 ? '🛵' : '✅')) %>
                        </div>
                        <div class="step-label"><%= stepName === 'Preparing' ? 'In The Kitchen' : stepName %></div>
                    </div>
                <% }); %>
            </div>
        <% } %>

        <!-- Order Summary & Address Grid -->
        <div style="display: grid; grid-template-columns: 1.2fr 0.8fr; gap: 2rem; margin-top: 2rem; padding-top: 2rem; border-top: 1px solid var(--border-color);">
            <div>
                <h3 style="font-size: 1.15rem; margin-bottom: 1rem;">Items In This Order:</h3>
                <div style="display: flex; flex-direction: column; gap: 0.8rem;">
                    <% order.items.forEach(function(item) { %>
                        <div style="display: flex; align-items: center; justify-content: space-between; background: #F8FAFC; padding: 0.8rem 1rem; border-radius: var(--radius-md);">
                            <div style="display: flex; align-items: center; gap: 0.8rem;">
                                <img src="<%= item.image || '/images/biriyani.jpeg' %>" style="width: 48px; height: 48px; border-radius: 8px; object-fit: cover;" onerror="this.src='/images/biriyani.jpeg'">
                                <div>
                                    <div style="font-weight: 700; font-size: 0.95rem;"><%= item.name %></div>
                                    <div style="font-size: 0.8rem; color: var(--text-muted);">Quantity: <%= item.quantity %></div>
                                </div>
                            </div>
                            <div style="font-weight: 800; color: var(--secondary);">
                                ₹<%= item.price * item.quantity %>
                            </div>
                        </div>
                    <% }); %>
                </div>
            </div>

            <div style="background: #F8FAFC; padding: 1.5rem; border-radius: var(--radius-lg); border: 1px solid var(--border-color); display: flex; flex-direction: column; justify-content: space-between;">
                <div>
                    <h4 style="font-size: 1.05rem; margin-bottom: 0.8rem; color: var(--secondary);">Delivery Details:</h4>
                    <p style="font-size: 0.9rem; color: var(--text-muted); margin-bottom: 0.3rem;">Recipient:</p>
                    <p style="font-weight: 700; margin-bottom: 0.8rem;"><%= order.customerName %> (<%= order.customerPhone %>)</p>
                    
                    <p style="font-size: 0.9rem; color: var(--text-muted); margin-bottom: 0.3rem;">Destination:</p>
                    <p style="font-size: 0.9rem; font-weight: 600; line-height: 1.4;"><%= order.deliveryAddress %></p>
                </div>

                <div style="margin-top: 1.5rem; padding-top: 1rem; border-top: 1px dashed var(--border-color);">
                    <div style="display: flex; justify-content: space-between; font-size: 0.9rem; margin-bottom: 0.3rem;">
                        <span>Subtotal:</span>
                        <span>₹<%= order.subtotal %></span>
                    </div>
                    <% if (order.discount > 0) { %>
                        <div style="display: flex; justify-content: space-between; font-size: 0.9rem; color: #16A34A; margin-bottom: 0.3rem;">
                            <span>Discount:</span>
                            <span>-₹<%= order.discount %></span>
                        </div>
                    <% } %>
                    <div style="display: flex; justify-content: space-between; font-size: 0.9rem; margin-bottom: 0.3rem;">
                        <span>Delivery & Taxes:</span>
                        <span>₹<%= order.deliveryFee + order.tax %></span>
                    </div>
                    <div style="display: flex; justify-content: space-between; font-weight: 800; font-size: 1.2rem; color: var(--primary); margin-top: 0.5rem;">
                        <span>Total Paid:</span>
                        <span>₹<%= order.totalAmount %></span>
                    </div>
                </div>
            </div>
        </div>

        <!-- Order Action Buttons -->
        <% if (currentUser && order.orderStatus === 'Placed') { %>
            <div style="margin-top: 2rem; padding-top: 1.5rem; border-top: 1px solid var(--border-color); text-align: right;">
                <button onclick="cancelMyOrder('<%= order.orderId %>')" class="btn btn-danger btn-sm">
                    Cancel Order ✕
                </button>
            </div>
        <% } %>
    </div>
</div>

<%- include('partials/footer') %>

<script>
async function cancelMyOrder(orderId) {
    if (!confirm('Are you sure you want to cancel this order?')) return;

    try {
        const res = await fetch(`/api/order/${orderId}/cancel`, {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' }
        });
        const data = await res.json();
        if (data.success) {
            showToast(data.message);
            setTimeout(() => { window.location.reload(); }, 1000);
        } else {
            showToast(data.message || 'Cannot cancel order.');
        }
    } catch (e) {
        showToast('Error cancelling order.');
    }
}
</script>
