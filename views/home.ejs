<%- include('partials/header') %>

<!-- HERO BANNER -->
<section class="hero">
    <div class="hero-container">
        <div class="hero-content">
            <h1>Fresh, Hot & Scrumptious Food <span>Straight to Your Door</span></h1>
            <p>Experience gourmet flavors prepared in state-of-the-art cloud kitchens. Delivered fast, hygienic, and piping hot!</p>
            
            <!-- Search Form -->
            <form action="/" method="GET" class="hero-search-box">
                <input type="text" name="search" placeholder="Search delicious dishes (e.g., Biryani, Pizza)..." value="<%= typeof searchQuery !== 'undefined' ? searchQuery : '' %>">
                <button type="submit" class="btn btn-primary" style="border-radius: var(--radius-lg); padding: 0 1.5rem;">Search</button>
            </form>

            <div class="hero-badges">
                <div class="hero-badge-item">
                    <span>⚡</span> 30 Mins Delivery
                </div>
                <div class="hero-badge-item">
                    <span>🧼</span> 100% Hygienic Kitchen
                </div>
                <div class="hero-badge-item">
                    <span>⭐</span> 4.8+ Top Rated
                </div>
            </div>
        </div>

        <div class="hero-image-card">
            <img src="/images/biriyani.jpeg" alt="Signature Special Biryani" onerror="this.src='/images/pizza.jpeg'">
            <div style="margin-top: 1rem; color: #fff; font-weight: 700; font-size: 1.1rem;">
                🔥 Chef's Signature: Royal Hyderabadi Biryani
            </div>
            <p style="color: #94A3B8; font-size: 0.85rem;">Slow-cooked dum biryani with rich saffron & tender spices</p>
        </div>
    </div>
</section>

<!-- PROMO COUPONS BANNER -->
<div style="background: #FFFBEB; border-bottom: 1px solid #FDE68A; padding: 0.75rem 1.5rem; text-align: center; font-size: 0.9rem; color: #92400E;">
    🎉 <strong>Special College Offer:</strong> Use coupon code <strong style="background: #FEF3C7; padding: 0.2rem 0.6rem; border-radius: 6px; border: 1px dashed #D97706;">COLLEGE50</strong> for ₹50 OFF on orders above ₹150! Or use <strong style="background: #FEF3C7; padding: 0.2rem 0.6rem; border-radius: 6px; border: 1px dashed #D97706;">WELCOME20</strong> for 20% OFF.
</div>

<!-- CATEGORY FILTER -->
<section class="category-section">
    <div class="category-scroll">
        <% (allCategories || ['All', 'Biryani & Rice', 'Fast Food', 'Main Course', 'Breakfast & Snacks', 'South Indian', 'Desserts & Drinks']).forEach(function(cat) { %>
            <a href="/?category=<%= encodeURIComponent(cat) %>" class="category-pill <%= (currentCategory === cat) ? 'active' : '' %>">
                <%= cat === 'All' ? '🍽️ All Menu' : (cat === 'Biryani & Rice' ? '🍚 Biryani & Rice' : (cat === 'Fast Food' ? '🍕 Fast Food' : (cat === 'Main Course' ? '🍲 Main Course' : (cat === 'Breakfast & Snacks' ? '🥟 Snacks & Breakfast' : (cat === 'South Indian' ? '🥞 South Indian' : '🧁 Desserts'))))) %>
            </a>
        <% }); %>
    </div>
</section>

<!-- FOOD MENU GRID -->
<section class="menu-section">
    <div class="section-header">
        <div class="section-title">
            <h2><%= currentCategory === 'All' ? 'Explore Our Kitchen Specialties' : currentCategory %></h2>
            <p>Showing <%= foods.length %> fresh dishes prepared with authentic ingredients</p>
        </div>
        <% if (searchQuery || currentCategory !== 'All') { %>
            <a href="/" class="btn btn-secondary btn-sm">Clear Filters ✕</a>
        <% } %>
    </div>

    <% if (foods.length === 0) { %>
        <div style="text-align: center; padding: 4rem 1.5rem; background: #fff; border-radius: var(--radius-lg); border: 1px solid var(--border-color);">
            <span style="font-size: 3.5rem;">🔍</span>
            <h3 style="margin-top: 1rem;">No matching dishes found</h3>
            <p style="color: var(--text-muted); margin-bottom: 1.5rem;">Try searching for something else or browse our full menu.</p>
            <a href="/" class="btn btn-primary">View Full Menu</a>
        </div>
    <% } else { %>
        <div class="food-grid">
            <% foods.forEach(function(food) { %>
                <div class="food-card">
                    <div class="food-img-wrapper">
                        <img src="<%= food.image %>" alt="<%= food.name %>" onerror="this.src='/images/biriyani.jpeg'">
                        <span class="veg-badge <%= food.isVeg ? 'veg' : 'non-veg' %>">
                            <span>●</span> <%= food.isVeg ? 'Veg' : 'Non-Veg' %>
                        </span>
                        <span class="rating-badge">
                            ★ <%= food.rating || '4.5' %>
                        </span>
                    </div>

                    <div class="food-info">
                        <div class="food-category"><%= food.category %></div>
                        <h3 class="food-name"><%= food.name %></h3>
                        <p class="food-desc"><%= food.description || 'Authentic flavor prepared with top ingredients.' %></p>
                        
                        <div class="food-footer">
                            <div class="food-price">
                                <span>₹</span><%= food.price %>
                            </div>

                            <button class="btn btn-primary btn-sm" onclick="addToCart('<%= food._id %>', '<%= food.name.replace(/'/g, "\\'") %>', <%= food.price %>, '<%= food.image %>')">
                                + Add to Cart
                            </button>
                        </div>
                    </div>
                </div>
            <% }); %>
        </div>
    <% } %>
</section>

<%- include('partials/footer') %>