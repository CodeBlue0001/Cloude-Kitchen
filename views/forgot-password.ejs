<%- include('partials/header') %>

<div class="auth-wrapper">
    <div class="auth-card">
        <div class="auth-header">
            <h2>Account Recovery 🔐</h2>
            <p>Enter your registered mobile number or email address to verify your account.</p>
        </div>

        <form id="forgotForm">
            <div class="form-group">
                <label for="identifier">Registered Mobile or Email</label>
                <input type="text" id="identifier" class="form-control" placeholder="e.g. 9876543210 or user@example.com" required>
            </div>

            <button type="submit" id="verifyBtn" class="btn btn-primary" style="width: 100%; margin-top: 0.8rem; padding: 0.8rem;">
                Verify Account Details 🔍
            </button>
        </form>

        <div style="text-align: center; margin-top: 1.5rem; font-size: 0.9rem; color: var(--text-muted);">
            Remembered password? <a href="/login" style="color: var(--primary); font-weight: 700;">Back to Login</a>
        </div>
    </div>
</div>

<%- include('partials/footer') %>

<script>
document.getElementById('forgotForm').addEventListener('submit', async (e) => {
    e.preventDefault();
    const identifier = document.getElementById('identifier').value.trim();
    const btn = document.getElementById('verifyBtn');

    btn.disabled = true;
    btn.innerText = 'Verifying... ⏳';

    try {
        const res = await fetch('/verify-mobile', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ identifier })
        });

        const data = await res.json();

        if (res.ok && data.success) {
            showToast(data.message);
            setTimeout(() => {
                window.location.href = '/reset-password';
            }, 1000);
        } else {
            showToast(data.message || 'Account not found.');
            btn.disabled = false;
            btn.innerText = 'Verify Account Details 🔍';
        }
    } catch (err) {
        console.error(err);
        showToast('Verification failed.');
        btn.disabled = false;
        btn.innerText = 'Verify Account Details 🔍';
    }
});
</script>
