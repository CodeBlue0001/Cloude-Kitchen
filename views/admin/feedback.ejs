<%- include('../partials/header') %>

<div style="max-width: 1240px; margin: 2rem auto 4rem; padding: 0 1.5rem; flex: 1;">
    <div style="margin-bottom: 2rem;">
        <div style="font-size: 0.9rem; color: var(--primary); font-weight: 700;">
            <a href="/admin">← Back to Dashboard</a>
        </div>
        <h1 style="font-size: 2rem; margin-top: 0.3rem;">Customer Inquiries & In-app Feedback ✉️</h1>
    </div>

    <div style="background: #fff; border-radius: var(--radius-lg); border: 1px solid var(--border-color); box-shadow: var(--card-shadow); padding: 2rem;">
        <% if (!messages || messages.length === 0) { %>
            <p style="color: var(--text-muted); text-align: center; padding: 3rem;">No customer inquiries received yet.</p>
        <% } else { %>
            <div style="overflow-x: auto;">
                <table style="width: 100%; border-collapse: collapse; text-align: left; font-size: 0.9rem;">
                    <thead>
                        <tr style="border-bottom: 2px solid var(--border-color); color: var(--text-muted);">
                            <th style="padding: 0.8rem;">Date</th>
                            <th style="padding: 0.8rem;">Customer</th>
                            <th style="padding: 0.8rem;">Subject</th>
                            <th style="padding: 0.8rem;">Message</th>
                        </tr>
                    </thead>
                    <tbody>
                        <% messages.forEach(function(msg) { %>
                            <tr style="border-bottom: 1px solid var(--border-color);">
                                <td style="padding: 0.9rem; color: var(--text-muted); font-size: 0.8rem;">
                                    <%= new Date(msg.createdAt).toLocaleDateString('en-US', { day: 'numeric', month: 'short', year: 'numeric', hour: '2-digit', minute: '2-digit' }) %>
                                </td>

                                <td style="padding: 0.9rem;">
                                    <div style="font-weight: 700;"><%= msg.name %></div>
                                    <div style="font-size: 0.8rem; color: var(--text-muted);"><%= msg.email %></div>
                                    <% if (msg.phone) { %>
                                        <div style="font-size: 0.75rem; color: var(--primary);"><%= msg.phone %></div>
                                    <% } %>
                                </td>

                                <td style="padding: 0.9rem; font-weight: 600; color: var(--secondary);">
                                    <%= msg.subject %>
                                </td>

                                <td style="padding: 0.9rem; max-width: 400px; line-height: 1.4; color: var(--text-main);">
                                    <%= msg.message %>
                                </td>
                            </tr>
                        <% }); %>
                    </tbody>
                </table>
            </div>
        <% } %>
    </div>
</div>

<%- include('../partials/footer') %>
