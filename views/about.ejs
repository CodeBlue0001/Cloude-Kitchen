<%- include('partials/header') %>

<!-- ABOUT HERO -->
<section style="background: linear-gradient(135deg, #2B2D42 0%, #171927 100%); color: #fff; padding: 4rem 1.5rem; text-align: center;">
    <div style="max-width: 800px; margin: 0 auto;">
        <span style="background: rgba(255,94,58,0.2); color: var(--primary); padding: 0.3rem 0.9rem; border-radius: 20px; font-weight: 700; font-size: 0.85rem; text-transform: uppercase;">
            Gourmet Food Delivery
        </span>
        <h1 style="font-size: 2.8rem; color: #fff; margin: 1rem 0 0.8rem;">About Cloud Kitchen</h1>
        <p style="color: #CBD5E1; font-size: 1.15rem; line-height: 1.6;">
            We are revolutionizing food delivery with culinary excellence, smart kitchen automation, and zero-compromise hygiene.
        </p>
    </div>
</section>

<!-- MAIN CONTENT -->
<div style="max-width: 1100px; margin: 3.5rem auto 4rem; padding: 0 1.5rem; flex: 1;">
    <!-- Two Column Story -->
    <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 3rem; align-items: center; margin-bottom: 4rem;">
        <div>
            <h2 style="font-size: 2rem; margin-bottom: 1rem;">What is a Cloud Kitchen?</h2>
            <p style="color: var(--text-muted); font-size: 1rem; line-height: 1.7; margin-bottom: 1rem;">
                Unlike traditional dine-in restaurants, a <strong>Cloud Kitchen</strong> (also known as a dark or ghost kitchen) operates purely on a delivery and takeaway business model. By eliminating expensive dining hall overheads, we invest 100% of our focus into premium ingredients, master chefs, and rapid delivery logistics.
            </p>
            <p style="color: var(--text-muted); font-size: 1rem; line-height: 1.7;">
                Our intelligent order management system connects your favorite recipes directly to specialized cook stations, ensuring meals are prepared fresh per order and dispatched in thermal insulated carriers.
            </p>
        </div>

        <div style="background: #fff; padding: 2rem; border-radius: var(--radius-lg); border: 1px solid var(--border-color); box-shadow: var(--card-shadow);">
            <h3 style="font-size: 1.3rem; margin-bottom: 1.2rem; color: var(--primary);">🎯 Our Core Pillars</h3>
            <div style="display: flex; flex-direction: column; gap: 1rem;">
                <div style="display: flex; gap: 1rem;">
                    <div style="font-size: 1.5rem;">🧼</div>
                    <div>
                        <div style="font-weight: 700;">Zero-Contact Hygiene</div>
                        <div style="font-size: 0.88rem; color: var(--text-muted);">Sterilized cookware, automated temperature checks, and sealed tamper-proof packaging.</div>
                    </div>
                </div>
                <div style="display: flex; gap: 1rem;">
                    <div style="font-size: 1.5rem;">⚡</div>
                    <div>
                        <div style="font-weight: 700;">Express 30-Min Delivery</div>
                        <div style="font-size: 0.88rem; color: var(--text-muted);">Hyperlocal kitchen hubs positioned strategically for fast doorstep fulfillment.</div>
                    </div>
                </div>
                <div style="display: flex; gap: 1rem;">
                    <div style="font-size: 1.5rem;">🌿</div>
                    <div>
                        <div style="font-weight: 700;">Farm-Fresh Ingredients</div>
                        <div style="font-size: 0.88rem; color: var(--text-muted);">Daily sourced vegetables, premium aromatic spices, and non-GMO grains.</div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Technology & Architecture Showcase for College Minor Project -->
    <div style="background: #F8FAFC; border: 1px solid var(--border-color); border-radius: var(--radius-lg); padding: 2.5rem; text-align: center; margin-bottom: 4rem;">
        <h3 style="font-size: 1.6rem; margin-bottom: 0.5rem;">💻 Technical Architecture (Minor Project)</h3>
        <p style="color: var(--text-muted); max-width: 600px; margin: 0 auto 2rem; font-size: 0.95rem;">
            Built with modern full-stack web technologies demonstrating scalable MVC design, REST APIs, session authentication, and dynamic state management.
        </p>
        
        <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(200px, 1fr)); gap: 1.5rem;">
            <div style="background: #fff; padding: 1.5rem; border-radius: var(--radius-md); border: 1px solid var(--border-color);">
                <div style="font-size: 2rem; margin-bottom: 0.5rem;">🟢</div>
                <h4 style="margin-bottom: 0.3rem;">Node.js & Express</h4>
                <p style="font-size: 0.85rem; color: var(--text-muted);">Robust backend server with secure routing & session middleware.</p>
            </div>
            <div style="background: #fff; padding: 1.5rem; border-radius: var(--radius-md); border: 1px solid var(--border-color);">
                <div style="font-size: 2rem; margin-bottom: 0.5rem;">🍃</div>
                <h4 style="margin-bottom: 0.3rem;">MongoDB & Mongoose</h4>
                <p style="font-size: 0.85rem; color: var(--text-muted);">NoSQL document database for Users, Foods, Orders, and Inquiries.</p>
            </div>
            <div style="background: #fff; padding: 1.5rem; border-radius: var(--radius-md); border: 1px solid var(--border-color);">
                <div style="font-size: 2rem; margin-bottom: 0.5rem;">🎨</div>
                <h4 style="margin-bottom: 0.3rem;">EJS & Vanilla CSS</h4>
                <p style="font-size: 0.85rem; color: var(--text-muted);">Server-side rendered dynamic views with mobile responsive layouts.</p>
            </div>
        </div>
    </div>
</div>

<%- include('partials/footer') %>
