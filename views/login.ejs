<%- include('partials/header') %>

<div class="auth-wrapper">
    <div class="auth-card">
        <div class="auth-header">
            <h2>Welcome Back! 🍲</h2>
            <p>Login to your Cloud Kitchen account to order and track food.</p>
        </div>

        <!-- Demo Credentials Helper for College Viva & Review -->
        <div class="demo-credentials">
            <div style="font-weight: 700; margin-bottom: 0.3rem;">💡 Quick Demo Logins:</div>
            <div style="display: flex; gap: 0.5rem; margin-top: 0.4rem;">
                <button type="button" class="btn btn-secondary btn-sm" onclick="fillDemo('john@example.com', 'user123')">👤 Demo Customer</button>
                <button type="button" class="btn btn-admin btn-sm" onclick="fillDemo('admin@cloudkitchen.com', 'admin123')">🛠️ Demo Admin</button>
            </div>
        </div>

        <form id="loginForm">
            <div class="form-group">
                <label for="email">Email Address</label>
                <input type="email" id="email" class="form-control" placeholder="name@example.com" required>
            </div>

            <div class="form-group">
                <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 0.4rem;">
                    <label for="password" style="margin-bottom: 0;">Password</label>
                    <a href="/forgot-password" style="font-size: 0.8rem; color: var(--primary); font-weight: 600;">Forgot Password?</a>
                </div>
                <input type="password" id="password" class="form-control" placeholder="••••••••" required>
            </div>

            <button type="submit" id="loginSubmitBtn" class="btn btn-primary" style="width: 100%; margin-top: 0.8rem; padding: 0.8rem;">
                Login to Account 🚀
            </button>
        </form>

        <div style="text-align: center; margin-top: 1.5rem; font-size: 0.9rem; color: var(--text-muted);">
            Don't have an account? <a href="/register" style="color: var(--primary); font-weight: 700;">Create Account</a>
        </div>
    </div>
</div>

<%- include('partials/footer') %>

<script>
function fillDemo(email, pass) {
    document.getElementById('email').value = email;
    document.getElementById('password').value = pass;
    showToast(`Filled credentials for ${email}`);
}

document.getElementById('loginForm').addEventListener('submit', async (e) => {
    e.preventDefault();
    const email = document.getElementById('email').value;
    const password = document.getElementById('password').value;
    const btn = document.getElementById('loginSubmitBtn');

    btn.disabled = true;
    btn.innerText = 'Verifying... ⏳';

    try {
        const res = await fetch('/login', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ email, password })
        });

        const data = await res.json();

        if (res.ok && data.success) {
            showToast(data.message);
            setTimeout(() => {
                if (data.user && data.user.role === 'admin') {
                    window.location.href = '/admin';
                } else {
                    window.location.href = '/';
                }
            }, 1000);
        } else {
            showToast(data.message || 'Login failed.');
            btn.disabled = false;
            btn.innerText = 'Login to Account 🚀';
        }
    } catch (err) {
        console.error(err);
        showToast('Connection error during login.');
        btn.disabled = false;
        btn.innerText = 'Login to Account 🚀';
    }
});
</script>
