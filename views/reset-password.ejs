<%- include('partials/header') %>

<div class="auth-wrapper">
    <div class="auth-card">
        <div class="auth-header">
            <h2>Set New Password 🔑</h2>
            <p>Your identity has been verified. Create a strong new password for your account.</p>
        </div>

        <form id="resetForm">
            <div class="form-group">
                <label for="newPassword">New Password (Min 6 chars) *</label>
                <input type="password" id="newPassword" class="form-control" placeholder="••••••••" minlength="6" required>
            </div>

            <div class="form-group">
                <label for="confirmPassword">Confirm New Password *</label>
                <input type="password" id="confirmPassword" class="form-control" placeholder="••••••••" minlength="6" required>
            </div>

            <button type="submit" id="resetBtn" class="btn btn-primary" style="width: 100%; margin-top: 0.8rem; padding: 0.8rem;">
                Update Password & Login 🚀
            </button>
        </form>
    </div>
</div>

<%- include('partials/footer') %>

<script>
document.getElementById('resetForm').addEventListener('submit', async (e) => {
    e.preventDefault();
    const newPassword = document.getElementById('newPassword').value;
    const confirmPassword = document.getElementById('confirmPassword').value;
    const btn = document.getElementById('resetBtn');

    if (newPassword !== confirmPassword) {
        showToast('Passwords do not match!');
        return;
    }

    btn.disabled = true;
    btn.innerText = 'Updating Password... ⏳';

    try {
        const res = await fetch('/reset-password', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ newPassword, confirmPassword })
        });

        const data = await res.json();

        if (res.ok && data.success) {
            showToast(data.message);
            setTimeout(() => {
                window.location.href = '/login';
            }, 1200);
        } else {
            showToast(data.message || 'Password reset failed.');
            btn.disabled = false;
            btn.innerText = 'Update Password & Login 🚀';
        }
    } catch (err) {
        console.error(err);
        showToast('Error resetting password.');
        btn.disabled = false;
        btn.innerText = 'Update Password & Login 🚀';
    }
});
</script>
