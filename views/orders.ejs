<%- include('partials/header') %>

<div style="max-width: 1000px; margin: 2.5rem auto 4rem; padding: 0 1.5rem; flex: 1;">
    <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 2rem;">
        <div>
            <h2 style="font-size: 2rem;">My Order History 📦</h2>
            <p style="color: var(--text-muted);">Track your active kitchen orders or reorder past favorites.</p>
        </div>
        <a href="/" class="btn btn-primary btn-sm">+ Order More Food</a>
    </div>

    <% if (!orders || orders.length === 0) { %>
        <div style="text-align: center; padding: 4rem 1.5rem; background: #fff; border-radius: var(--radius-lg); border: 1px solid var(--border-color); box-shadow: var(--card-shadow);">
            <span style="font-size: 3.5rem;">🛵</span>
            <h3 style="margin-top: 1rem;">No orders placed yet</h3>
            <p style="color: var(--text-muted); margin-bottom: 1.5rem;">Explore our cloud kitchen menu to enjoy delicious, hot meals delivered to your doorstep!</p>
            <a href="/" class="btn btn-primary">Browse Menu 🍽️</a>
        </div>
    <% } else { %>
        <div style="display: flex; flex-direction: column; gap: 1.5rem;">
            <% orders.forEach(function(order) { %>
                <div style="background: #fff; border-radius: var(--radius-lg); border: 1px solid var(--border-color); box-shadow: var(--card-shadow); padding: 1.8rem;">
                    <div style="display: flex; justify-content: space-between; align-items: flex-start; border-bottom: 1px solid var(--border-color); padding-bottom: 1rem; margin-bottom: 1.2rem; flex-wrap: wrap; gap: 1rem;">
                        <div>
                            <span style="font-weight: 800; font-size: 1.15rem; color: var(--secondary);">Order #<%= order.orderId %></span>
                            <div style="color: var(--text-muted); font-size: 0.85rem; margin-top: 0.2rem;">
                                Placed on <%= new Date(order.createdAt).toLocaleDateString('en-US', { day: 'numeric', month: 'short', year: 'numeric', hour: '2-digit', minute: '2-digit' }) %>
                            </div>
                        </div>

                        <div style="display: flex; align-items: center; gap: 0.8rem;">
                            <% 
                                let badgeColor = '#3B82F6';
                                let badgeBg = '#EFF6FF';
                                if (order.orderStatus === 'Delivered') { badgeColor = '#16A34A'; badgeBg = '#F0FDF4'; }
                                else if (order.orderStatus === 'Preparing') { badgeColor = '#D97706'; badgeBg = '#FFFBEB'; }
                                else if (order.orderStatus === 'Cancelled') { badgeColor = '#DC2626'; badgeBg = '#FEF2F2'; }
                            %>
                            <span style="background: <%= badgeBg %>; color: <%= badgeColor %>; padding: 0.35rem 0.9rem; border-radius: 20px; font-weight: 700; font-size: 0.85rem; border: 1px solid <%= badgeColor %>;">
                                ● <%= order.orderStatus %>
                            </span>

                            <a href="/track-order/<%= order.orderId %>" class="btn btn-outline btn-sm">
                                Live Tracking 📍
                            </a>
                        </div>
                    </div>

                    <!-- Items Summary -->
                    <div style="display: grid; grid-template-columns: 2fr 1fr; gap: 1.5rem;">
                        <div>
                            <div style="font-weight: 700; font-size: 0.9rem; color: var(--secondary); margin-bottom: 0.6rem;">Items Ordered:</div>
                            <div style="display: flex; flex-direction: column; gap: 0.4rem;">
                                <% order.items.forEach(function(item) { %>
                                    <div style="display: flex; justify-content: space-between; font-size: 0.9rem; color: var(--text-main);">
                                        <span>• <%= item.name %> <strong>x<%= item.quantity %></strong></span>
                                        <span style="font-weight: 600;">₹<%= item.price * item.quantity %></span>
                                    </div>
                                <% }); %>
                            </div>
                        </div>

                        <div style="background: #F8FAFC; padding: 1rem; border-radius: var(--radius-md); font-size: 0.88rem;">
                            <div style="color: var(--text-muted); margin-bottom: 0.3rem;">Delivery Address:</div>
                            <div style="font-weight: 600; color: var(--secondary); line-height: 1.4;"><%= order.deliveryAddress %></div>
                            
                            <div style="margin-top: 0.8rem; padding-top: 0.8rem; border-top: 1px dashed var(--border-color); display: flex; justify-content: space-between; font-weight: 800; font-size: 1rem;">
                                <span>Total Paid:</span>
                                <span style="color: var(--primary);">₹<%= order.totalAmount %></span>
                            </div>
                        </div>
                    </div>
                </div>
            <% }); %>
        </div>
    <% } %>
</div>

<%- include('partials/footer') %>
